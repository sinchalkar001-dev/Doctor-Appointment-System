# Copy this file to server/.env and fill in the values.

# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-appointment-system

NODE_ENV=development
PORT=5000

# Required. Use a long random string, at least 32 characters in production.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10

# Optional. Comma-separated browser origins allowed to call the API, for example
# http://localhost:3000. Leave empty during development to allow any origin.
CLIENT_ORIGIN=
