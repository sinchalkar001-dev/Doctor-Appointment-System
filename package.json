{
  "name": "doctor-appointment-system",
  "version": "2.0.0",
  "description": "Modern Doctor Appointment System with Node.js, MongoDB, React & Tailwind",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix ./client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix ./client",
    "seed": "node scripts/seedData.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.1",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.7",
    "concurrently": "^9.0.1"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=16.0.0"
  }
}
